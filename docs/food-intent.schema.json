{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daywell preview food intent v1",
  "type": "object",
  "required": ["action"],
  "additionalProperties": false,
  "properties": {
    "action": { "const": "recommend" },
    "mode": { "enum": ["cook", "eatOut", "compare"] },
    "sort": { "enum": ["catalog", "time", "cost", "protein"] },
    "contextPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": { "type": "integer", "minimum": 1, "maximum": 1440 }
      }
    },
    "profilePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
