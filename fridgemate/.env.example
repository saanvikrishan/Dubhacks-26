# Keep secrets on the FastAPI backend. Never prefix them with VITE_.
# Loaded from fridgemate/.env or backend/.env
GEMINI_API_KEY=
# Optional override; default is gemini-3.8-flash
GEMINI_MODEL=
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
MONGODB_URI=
MONGODB_DATABASE=
# Proposed internal names; confirm against the chosen Photon 2.0 implementation.
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
