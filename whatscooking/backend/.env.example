# Copy to backend/.env or keep keys in ../.env (parent whatscooking/.env also loads).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
DATABASE_URL=
DAYWELL_USER_ID=demo
USDA_API_KEY=

GOOGLE_MAPS_API_KEY=

# Kroger public product/location API (server-side only)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Photon / Spectrum iMessage reminders ──────────────────────────────────────
# Get these from your Spectrum project dashboard.
# Run: node photon/remind.mjs phone +15551234567  (register your number once)
# Then: node photon/remind.mjs  (start the polling daemon)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
